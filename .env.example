APP_NAME="PDF Knowledge Assistant"
APP_ENV=development
LOG_LEVEL=INFO

# Storage paths are relative to the project root by default.
UPLOAD_DIR=storage/uploads
INDEX_DIR=storage/index
DATABASE_URL=sqlite:///storage/app.db

# Auth: create long random values; do not commit real secrets.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
OAUTH_STATE_SECRET=replace-with-a-different-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:8000/
CORS_ORIGINS=http://localhost:8000

# Use gemini online; use hash with LLM_PROVIDER=mock for offline development.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=8

# Choose one: gemini, openai, or mock.
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Evidence gate; calibrate for your embedding provider and corpus.
MIN_RETRIEVAL_SCORE=0.20
MAX_UPLOAD_MB=10
